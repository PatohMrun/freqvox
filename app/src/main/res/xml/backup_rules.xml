<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy Auto Backup rules (Android < 12). Same intent as
    data_extraction_rules.xml: keep the Room DB out of the cloud backup so a
    stale snapshot can't overwrite fresh local data on reinstall.
-->
<full-backup-content>
    <exclude domain="database" path="freqvox.db" />
    <exclude domain="database" path="freqvox.db-shm" />
    <exclude domain="database" path="freqvox.db-wal" />
    <exclude domain="database" path="freqvox.db-journal" />
</full-backup-content>
