<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup / D2D rules (Android 12+).

    The Room database (freqvox.db + WAL/SHM/journal sidecars) is excluded from
    cloud backup so a stale snapshot pushed earlier cannot be restored on top of
    fresh local data when the app is reinstalled. That restore-overwrite was a
    plausible cause of "playlists keep resetting" between debug installs.

    Device-to-device transfer keeps the DB included so a user moving phones
    still gets their library and playlists across.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="freqvox.db" />
        <exclude domain="database" path="freqvox.db-shm" />
        <exclude domain="database" path="freqvox.db-wal" />
        <exclude domain="database" path="freqvox.db-journal" />
    </cloud-backup>
    <device-transfer>
        <!-- intentionally empty: include everything by default -->
    </device-transfer>
</data-extraction-rules>
